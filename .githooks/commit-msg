#!/usr/bin/env bash
# commit-msg — 커밋 메시지에서 AI 협업자 흔적을 지운다.
#
# 이 저장소의 커밋 기록에는 사람만 남는다. AI 도구가 붙이는 공동 작성자 트레일러와
# 홍보 문구는 저자 정보를 흐리고, GitHub 기여자 목록에 사람이 아닌 항목을 만든다.
#
# 설치:
#   git config core.hooksPath .githooks
#
# 이 훅은 커밋을 막지 않는다 — 조용히 지우고 통과시킨다.
# 다만 훅은 `--no-verify` 로 건너뛸 수 있으므로 최종 강제는 CI 가 한다.
#   .github/workflows/commit-hygiene.yml

set -uo pipefail

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

# 지우는 줄
#   Co-Authored-By: Claude …            공동 작성자 트레일러
#   Co-authored-by: … @anthropic.com    같은 것의 다른 표기
#   Claude-Session: …                   세션 링크
#   🤖 Generated with [Claude Code](…)  홍보 문구
#   _Generated by [Claude Code](…)_     같은 것의 코멘트용 표기
#   https://claude.ai/code              위 문구에 딸려 오는 링크 한 줄
PATTERNS='^[[:space:]]*co-authored-by:[[:space:]]*claude
^[[:space:]]*co-authored-by:.*(anthropic\.com|claude)
^[[:space:]]*claude-session:[[:space:]]*http
^[[:space:]]*_?(🤖[[:space:]]*)?generated (with|by) \[claude code\]
^[[:space:]]*https://claude\.ai/code/?[[:alnum:]_-]*[[:space:]]*$'

cleaned="$(mktemp)" || exit 0
trap 'rm -f "$cleaned"' EXIT

grep -viE "$PATTERNS" "$msg_file" > "$cleaned" || true

# 트레일러를 걷어내면 그 앞의 구분선(---)과 빈 줄만 남는다. 같이 정리한다.
awk '
  { line[NR] = $0 }
  END {
    last = NR
    while (last > 0 && (line[last] ~ /^[[:space:]]*$/ || line[last] ~ /^[[:space:]]*-{3,}[[:space:]]*$/)) last--
    for (i = 1; i <= last; i++) print line[i]
  }
' "$cleaned" > "$msg_file"

# 지우고 나니 본문이 통째로 사라졌다면 그건 사람이 쓴 메시지가 없었다는 뜻이다.
if ! grep -qE '[^[:space:]#]' "$msg_file"; then
  echo "commit-msg: 커밋 메시지가 비어 있습니다. 무엇을 왜 바꿨는지 적어 주세요." >&2
  exit 1
fi

exit 0
